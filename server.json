{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.zhiyuanvision-lang/inkmap-markdown-mindmap-markmap",
  "title": "Markdown AI Mind Map — Inkmap | AI Markdown 思维导图",
  "description": "Turn long, messy AI Markdown (.md) into a clear, editable mind map & Mermaid flowchart | AI 思维导图",
  "version": "0.3.21",
  "websiteUrl": "https://zhiyuanv.com/software.html",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/zhiyuanvision-lang/InkMap/main/packages/vscode/images/icon.png",
      "mimeType": "image/png",
      "sizes": [
        "128x128"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/zhiyuanvision-lang/InkMap",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "inkmap-mcp",
      "version": "0.3.21",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
